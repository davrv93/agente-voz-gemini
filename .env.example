# Copia este archivo como .env y pega tu llave de Google AI Studio (https://aistudio.google.com/apikey).
# El archivo .env no se sube a Git (está en .gitignore). Nunca pegues la llave en el código.
GEMINI_API_KEY=pega-aqui-tu-llave

# Modelos (verificados el 24-11-2026 en ai.google.dev/gemini-api/docs/models)
MODELO_VOZ=gemini-3.8-flash-tts
MODELO_VOZ_RESPALDO=gemini-3.8-flash-lite-tts
MODELO_OIDO=gemini-3.5-flash-lite
MODELO_OIDO_RESPALDO=gemini-3.1-flash-lite

# Puerto de la página: http://127.0.0.1:8090
PUERTO=8090

# Tope de pedidos a Gemini por IP y por hora (cuida tu cuota)
LIMITE_POR_HORA=60
